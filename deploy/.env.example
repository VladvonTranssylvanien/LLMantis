# Template for deploy/.env on the server. SAFE TO COMMIT - no values here.
#
#   cp deploy/.env.example deploy/.env      then fill it in on the server
#
# deploy/.env is gitignored by the `.env` rule, which matches at any depth.
# Confirm it yourself rather than trusting this line:
#
#   git check-ignore -v deploy/.env
#
# The repository is public. Anything committed is world-readable at once and
# permanent in history - see SECRETS.md.


# ── the site ────────────────────────────────────────────────────────────────
# Bare domain or subdomain, no scheme and no trailing slash. Its A record must
# already point at this server before the first start, or Caddy cannot get a
# certificate.
LLMANTIS_DOMAIN=

# The whole site sits behind this login while Impressum and Datenschutz are
# still placeholders. Generate the hash ON THE SERVER and paste only the hash:
#
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your-password'
#
# The result starts with $2a$. Doubling every $ is required - compose reads a
# single $ as a variable reference and would silently mangle the hash:
#
#   LLMANTIS_PASSWORD_HASH=$$2a$$14$$....
LLMANTIS_USER=
LLMANTIS_PASSWORD_HASH=


# ── database ────────────────────────────────────────────────────────────────
# Not the development password. This one is never typed into a laptop.
POSTGRES_USER=llmantis
POSTGRES_PASSWORD=
POSTGRES_DB=llmantis

# Host is the compose service name, not localhost: the app and the database
# are separate containers on the same network. Must match the three values
# above.
DATABASE_URL=postgresql+psycopg://llmantis:CHANGE_ME@postgres:5432/llmantis


# ── judge ───────────────────────────────────────────────────────────────────
# There is no mock provider. Without a key every attack errors and no grade is
# issued, under an HTTP 200.
MISTRAL_API_KEY=
JUDGE_MODEL=mistral-small
CONCURRENCY=3


# ── auth ────────────────────────────────────────────────────────────────────
# Must be set and must be stable. Left empty, config.py generates a random one
# at startup, which logs every user out on every restart and on every deploy.
#
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
JWT_EXPIRE_HOURS=24
