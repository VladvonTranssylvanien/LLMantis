# PROVIDER: which LLM to use
# Options: "mock" (free testing), "mistral" (EU - PRODUCTION)
PROVIDER=mock

# API KEYS - Leave empty for mock mode, set when using Mistral
# Mistral: Get from https://console.mistral.ai/api-keys (France-based, EU-compliant)
# CRITICAL: Judge processes customer trade secrets. Must be EU provider only.
MISTRAL_API_KEY=

# JUDGE_MODEL: evaluates if attacks succeeded (MUST be EU for customer data protection)
# Default: mistral-small (France-based)
JUDGE_MODEL=mistral-small

# CONCURRENCY: how many attacks run in parallel.
# 3 is the measured ceiling for our current Mistral tier - at 5, three
# back-to-back scans hit 429s hard enough to void a grade. See backend/config.py.
CONCURRENCY=3

# DATABASE: PostgreSQL connection string
# Default: local Docker instance (see docker-compose.yml)
# Format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://llmantis:llmantis_dev_password@localhost:5432/llmantis

# JWT_SECRET: signs login tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty in dev and the app generates a random one at startup (logs everyone
# out on every restart). Set a real, fixed value before anything but local dev.
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# ALLOW_PRIVATE_SCAN_TARGETS: let an api-mode scan target a loopback/private
# address (127.0.0.1, 192.168.x, ...) without DNS ownership verification.
# Needed to scan the local lab in lab/runner.py, which can never pass DNS
# verification - there is no record to publish for 127.0.0.1.
# OFF by default: on a deployed server this would let a logged-in caller aim
# a scan at our own internal network. Local development only.
ALLOW_PRIVATE_SCAN_TARGETS=false
