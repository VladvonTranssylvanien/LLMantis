# PROVIDER: which LLM to use
# Options: "mock" (free testing), "anthropic" (US), "mistral" (EU - RECOMMENDED)
PROVIDER=mock

# API KEYS - Leave empty for mock mode, set when using real providers
# Anthropic: Get from https://console.anthropic.com/api_keys (US-based)
ANTHROPIC_API_KEY=

# Mistral: Get from https://console.mistral.ai/api-keys (France-based, EU-compliant)
# IMPORTANT: Judge processes customer trade secrets. Must be EU provider.
MISTRAL_API_KEY=

# LLM MODELS
# TARGET_MODEL: simulates the customer's bot (can use any provider)
TARGET_MODEL=claude-sonnet-4-5

# JUDGE_MODEL: evaluates if attacks succeeded (MUST be EU for customer data protection)
# Default: mistral-small (France-based)
JUDGE_MODEL=mistral-small

# CONCURRENCY: how many attacks run in parallel (5 is safe to avoid rate limits)
CONCURRENCY=5

# DATABASE: PostgreSQL connection string
# Default: local Docker instance (see docker-compose.yml)
# Format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://llmantis:llmantis_dev_password@localhost:5432/llmantis
