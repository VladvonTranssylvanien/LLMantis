# PROVIDER: which provider runs the JUDGE. "azure" or "mistral".
# The target does NOT come from here any more - see TARGET_* below.
PROVIDER=azure

# --- The judge -----------------------------------------------------------
# AZURE_URL is the FULL chat-completions url, copied verbatim from the Azure
# deployment page. Do not assemble it from resource + deployment + api-version:
# Azure OpenAI and Azure AI model inference use different paths, and taking the
# whole url means we work with either.
AZURE_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/chat/completions
AZURE_KEY=
AZURE_AUTH=api-key          # or "bearer" - this resource accepts both

# JUDGE_MODEL: evaluates whether an attack succeeded. It reads customer system
# prompts, which are trade secrets - that governs retention and logging.
JUDGE_MODEL=gpt-4.1

# Kept only so the recorded judge-agreement baseline (mean 94.3 %, range 26-30
# of 30) stays reproducible - it was measured on mistral-small.
MISTRAL_API_KEY=

# --- The target under attack (mode="model") ------------------------------
# The bot being scanned is a REAL deployment reached over HTTP, not a prompt
# replayed on our own provider. The deployment holds no instructions of its
# own, so the scan sends the system prompt with every request - which is also
# how many real chatbots work: the application owns the prompt.
#
# Config-only on purpose. A caller-supplied target url is mode="api", and that
# is gated behind DNS ownership verification.
TARGET_URL=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/chat/completions
TARGET_KEY=
TARGET_MODEL=gpt-4.1-mini
TARGET_AUTH=api-key

# How long one model call may take. gpt-4.1 answers in ~1 s; a reasoning model
# was measured at 31.8 s, over the 30 s mode="api" allows.
LLM_TIMEOUT_S=60

# CONCURRENCY: how many attacks run in parallel.
# 3 is the measured ceiling for our current Mistral tier - at 5, three
# back-to-back scans hit 429s hard enough to void a grade. See backend/config.py.
CONCURRENCY=3

# ATTACK_LIBRARY: which corpus in attacks/ a scan runs when the request does
# not name one. Two exist and they are not interchangeable:
#   attacks_short.yaml  21 attacks, v1.4  ~21 s, ~34 Mistral requests
#   attacks.yaml        78 attacks, v2.0  ~96 s, ~121 requests
# The free Mistral tier allows 50 requests/minute, so the 78-attack set cannot
# finish inside one window - the same bot came back ungraded / C / A on three
# identical runs. The short set is the default for that reason and because the
# 78-attack set scores a leaking bot HIGHER (technical debt #15, undecided).
# A scan request may override this per call with "library": "attacks.yaml".
ATTACK_LIBRARY=attacks_short.yaml

# DATABASE: PostgreSQL connection string
# Default: local Docker instance (see docker-compose.yml)
# Format: postgresql+psycopg://user:password@host:port/database
DATABASE_URL=postgresql+psycopg://llmantis:llmantis_dev_password@localhost:5432/llmantis

# JWT_SECRET: signs login tokens. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave empty in dev and the app generates a random one at startup (logs everyone
# out on every restart). Set a real, fixed value before anything but local dev.
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# ALLOW_PRIVATE_SCAN_TARGETS: let an api-mode scan target a loopback/private
# address (127.0.0.1, 192.168.x, ...) without DNS ownership verification.
# Needed to scan the local lab in lab/runner.py, which can never pass DNS
# verification - there is no record to publish for 127.0.0.1.
# OFF by default: on a deployed server this would let a logged-in caller aim
# a scan at our own internal network. Local development only.
ALLOW_PRIVATE_SCAN_TARGETS=false

# SCAN_UNVERIFIED_DOMAINS: public domains an api-mode scan may target without
# DNS ownership verification, comma separated. For our own test bots while they
# are still moving between hosts - never for a customer's domain, since the
# verification is the only thing proving they asked to be attacked.
# Empty by default: a domain gets in only by being named here.
#   SCAN_UNVERIFIED_DOMAINS=bot.example.com,staging.example.com
SCAN_UNVERIFIED_DOMAINS=

# --- The model that reads a page and finds the chat button --------------------
# Used ONLY by backend/art50opener.py, to pick which element to click when the
# keyword opener cannot reach a chat message box. Leave empty and that fallback
# is skipped - the keyword opener still runs.
#
# This is NOT the judge and is deliberately not on the judge's provider. The
# judge stays on Mistral because it reads customer system prompts, which are
# trade secrets. This one receives a list of button labels from a public page.
# Copy the URL verbatim from the Azure Foundry deployment page, api-version and
# all.
ART50_AI_URL=
ART50_AI_KEY=
# api-key for Azure OpenAI, bearer for the model-inference endpoint
ART50_AI_AUTH=api-key
ART50_AI_MODEL=gpt-4.1-mini
ART50_AI_TIMEOUT_S=20
