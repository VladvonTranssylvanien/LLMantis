# Generated by test_fixtures.py on every run.
fixtures/

# Screenshots of scanned pages. Never commit these: on a customer scan they are
# a picture of a third party's site, and on a lab run they are just noise.
shots/

# The live-chat slice of enthec/webappanalyzer, fetched by fetch_signatures.py.
#
# NOT committed on purpose. It is GPL-3.0 data and this repository is public, so
# committing it means redistributing it — which needs the licence notice and
# Kwabena's confirmation that GPL-3.0 data in an AGPL-3.0 project is clean (it
# very likely is; the point is not to guess in public). Until then everyone
# fetches their own copy, which takes three seconds. engine.py runs without it.
livechat.json
