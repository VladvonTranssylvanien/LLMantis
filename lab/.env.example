# Template for lab/.env — SAFE TO COMMIT, it contains no values.
#
#   cp lab/.env.example lab/.env     then fill in the real values
#
# lab/.env is gitignored and must never be committed. Verified with
# `git check-ignore`. Note that ONLY the exact name `.env` is protected here:
# `lab/azure.env` and `lab/bots/keys.yaml` are NOT ignored and would be
# committed. This repository is public by decision (PROJECT-STATE.md:45), so
# anything committed is world-readable at once and permanent in history.
#
# ── Where the real values live ──────────────────────────────────────────────
# In a shared password manager vault, never in this repo, never in chat,
# email or Slack (SECRETS.md). Each person copies from the vault into their
# own local lab/.env.
#
# If a key is ever pasted into a message or committed: rotate it in the Azure
# portal. Do not try to remove it from history - treat it as burned.


# Full chat-completions URL, copied verbatim from the Foundry deployment page.
# Take the whole URL rather than assembling it: Azure OpenAI and Azure AI model
# inference use different paths, and the runner does not care which you have.
#
# NOTE: Foundry may show you a `/openai/v1/responses` URL. That is the Responses
# API and the runner does not speak it. Use /chat/completions on the same
# resource - verified working:
LAB_AZURE_URL=https://<your-resource>.services.ai.azure.com/openai/v1/chat/completions

# The deployment key.
LAB_AZURE_KEY=

# Model name, sent in the request body.
# Required whenever the URL carries no deployment name, which is the case for
# the /openai/v1/ form above.
LAB_AZURE_MODEL=gpt-4.1-mini

# Auth header style: "api-key" (default) or "bearer".
# The services.ai.azure.com resource accepts both - verified. Leave unset
# unless a model rejects the default.
# LAB_AZURE_AUTH=api-key
